{
	"name": "mapsteps/better-admin-bar",
	"description": "Better Admin Bar – replace the WordPress admin bar with a quick access panel, auto-hide it or hide it by user role.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.1"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs --standard=phpcs.xml --exclude=Generic.Files.LineEndings .",
		"fix": "phpcbf --standard=phpcs.xml --exclude=Generic.Files.LineEndings ."
	}
}
